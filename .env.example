# Copy to .env.local and fill in what you use. Generated from src/lib/config.ts
# by `npm run env:docs`; docs/configuration.md explains each one.

# Email
# Sends every email (inquiries, confirmations, sign-in links, client messages).
RESEND_API_KEY=
# The verified sender address.
RESEND_FROM=
# Where owner alerts go (new inquiries, forwarded client replies, the morning email).
INQUIRY_TO=
# The receiving subdomain for client replies (reply+<token>@ and log+<token>@).
RESEND_INBOUND_DOMAIN=
# Verifies Resend's delivery and inbound events at /api/email/webhook.
RESEND_WEBHOOK_SECRET=
# Where preview and local builds send email instead of the real recipient.
DEV_EMAIL_TO=
# Set to false to stop the emails when a client edits their portal details, starts a project or uploads a file.
NOTIFY_CLIENT_EDITS=

# Clients and sign-in
# The private client store (projects, messages, settings).
SUPABASE_URL=
# Server-only key for the client store.
SUPABASE_SERVICE_ROLE_KEY=
# Signs portal and admin sign-in links and sessions.
AUTH_SECRET=
# The owner addresses allowed into /admin, comma-separated. List both the studio address and the inbox it forwards to, so a reply from either counts as yours.
ADMIN_EMAIL=
# Vercel Blob, for questionnaire uploads, portal documents and plan PDFs.
BLOB_READ_WRITE_TOKEN=

# Content
# The Sanity project the content comes from.
NEXT_PUBLIC_SANITY_PROJECT_ID=
# The Sanity dataset.
NEXT_PUBLIC_SANITY_DATASET=
# Verifies Sanity's publish webhook so pages refresh at once.
SANITY_WEBHOOK_SECRET=

# AI
# Every AI feature: drafting, triage, the concierge, alt text.
GROQ_API_KEY=
# A different OpenAI-compatible provider.
AI_BASE_URL=
# Pins the main model while the provider still serves it.
AI_MODEL=
# Pins the fallback model.
AI_FALLBACK_MODEL=
# Pins the model used for image alt text.
AI_VISION_MODEL=

# SMS
# Twilio account for confirmation texts (all three TWILIO_* are needed).
TWILIO_ACCOUNT_SID=
# Twilio auth token.
TWILIO_AUTH_TOKEN=
# The sending number, E.164.
TWILIO_PHONE_FROM=
# Your own number, for a text when a new inquiry looks worth an interruption (a good fit, or high urgency that isn't a mismatch; every inquiry when there's no AI assessment). Needs the TWILIO_* settings.
INQUIRY_SMS_TO=

# Other services
# Live Google reviews and address autocomplete.
GOOGLE_PLACES_API_KEY=
# The Google Business listing for reviews.
GOOGLE_PLACE_ID=
# Authorizes the daily cron (keep-alive, delivery check, morning email, AI model check).
CRON_SECRET=
# Error reporting.
NEXT_PUBLIC_SENTRY_DSN=
# Set to 1 to report errors from a local dev server.
SENTRY_DEV=
# Set to 1 to report browser errors from a local dev server.
NEXT_PUBLIC_SENTRY_DEV=

# Tests
# Points Resend at the e2e fake provider. Never set in production.
RESEND_BASE_URL=
# Points Twilio at the e2e fake provider. Never set in production.
TWILIO_BASE_URL=
